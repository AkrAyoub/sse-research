# COPY LOCALLY TO A VM-PRIVATE .env AFTER operator review. NEVER COMMIT .env.
# Besu image requires a tested immutable digest; no version guessed or substituted.
BESU_IMAGE=hyperledger/besu:REVIEWED_VERSION@sha256:REPLACE_WITH_REAL_64_HEX_DIGEST
BESU_UID=1000
BESU_GID=1000
# Each value is an EXISTING path on THIS Ubuntu machine, not a shared NFS volume.
BESU_DATA=/srv/sse-qbft/data
BESU_GENESIS=/srv/sse-qbft/config/genesis.json
BESU_NODE_KEY=/srv/sse-qbft/private/node.key
BESU_BOOTNODES=/srv/sse-qbft/config/bootnodes.txt
# Own Tailscale IPv4; do not use 10.50.56.x lab DHCP IP.
TAILSCALE_IPV4=100.REPLACE.REPLACE.REPLACE
