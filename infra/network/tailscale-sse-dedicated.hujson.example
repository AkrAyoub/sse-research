// REVIEWED EXAMPLE for a DEDICATED SSE research tailnet.
// DO NOT paste wholesale into your personal mixed-use tailnet without first
// auditing all existing grants/ACLs and access needs.
// If the tailnet has no custom policy, Tailscale may apply allow-all defaults.
// The following is only an example: owner's approval and policy tests required.
{
  "tagOwners": {
    "tag:sse-validator": ["autogroup:admin"],
    "tag:sse-node": ["autogroup:admin"],
    "tag:sse-enrollment": ["autogroup:admin"]
  },
  "grants": [
    // Besu private chain 31338 P2P (TCP and UDP).
    {
      "src": ["tag:sse-validator"],
      "dst": ["tag:sse-validator"],
      "ip": ["tcp:30303", "udp:30303"]
    },
    // Observer/full node participation is explicitly read-only in consensus.
    {
      "src": ["tag:sse-node"],
      "dst": ["tag:sse-validator"],
      "ip": ["tcp:30303", "udp:30303"]
    },
    // Operator SSH maintenance only; RPC stays loopback via pinned SSH.
    {
      "src": ["autogroup:admin"],
      "dst": ["tag:sse-validator", "tag:sse-node", "tag:sse-enrollment"],
      "ip": ["tcp:22"]
    }
  ]
}
