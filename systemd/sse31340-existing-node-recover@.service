[Unit]
Description=SSE 31340 guarded existing EL/BN network recovery (%i), never validators
Wants=docker.service zerotier-one.service
After=docker.service zerotier-one.service
StartLimitIntervalSec=0

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 -B /usr/local/libexec/sse_pos_r92_guarded_existing_node_recovery.py --role %i --apply
Restart=on-failure
RestartSec=15s
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
UMask=077
TimeoutStartSec=180s
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
